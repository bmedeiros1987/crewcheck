# Laurinha Connected Hub - variaveis de ambiente
#
# Este arquivo e um modelo. NAO comite valores reais.
# Segredos vivem SO aqui, no PC que roda o Hub (192.168.0.32).
# Nada disto pode ir para o app da TV nem para o IPK.

# --- Home Assistant ---------------------------------------------------------
HA_BASE_URL=http://192.168.0.56:8123
# Token de longa duracao do HA. Fica somente no Hub.
HA_TOKEN=
HA_TIMEOUT_MS=5000
HA_RETRIES=1

# --- Hub --------------------------------------------------------------------
LAURINHA_HUB_HOST=0.0.0.0
LAURINHA_HUB_PORT=8188
# Chave que a TV manda no header X-Laurinha-Key. Diferente do token do HA:
# esta pode ficar no app da TV, o token do HA nunca.
LAURINHA_BRIDGE_KEY=
# Endereco pelo qual a TV alcanca o Hub, usado para montar as URLs de midia.
LAURINHA_PUBLIC_BASE_URL=http://192.168.0.32:8188
# 1 = exigir a bridge key tambem nas leituras (GET). Padrao: so nas escritas.
LAURINHA_REQUIRE_KEY_FOR_READS=0

# --- Biblioteca -------------------------------------------------------------
# Raiz com MINHAS_MUSICAS/ e FOTOS_LAURINHA/.
LAURINHA_MEDIA_ROOT=
# Manifesto publicado pelo Laurinha Manager. Quando presente, tem prioridade
# sobre a varredura de disco (traz playlists, albuns, capas e Modo Quadro).
LAURINHA_MANIFEST=

# --- Entidades do Home Assistant -------------------------------------------
# Arquivo JSON com outputs, scripts e acoes de casa. Ver
# laurinha-hub.config.example.json.
LAURINHA_HUB_CONFIG=

# --- CORS -------------------------------------------------------------------
# Origens permitidas, separadas por virgula. Vazio = qualquer origem da rede.
LAURINHA_TV_ORIGINS=
# App webOS empacotado manda Origin "null"/"file://". 0 para bloquear.
LAURINHA_ALLOW_PACKAGED_APP=1
