// CrewCheck v14.0.3 — Concierge humano, natural e personalizável.
function conciergeDayForKey(roster = {}, key = '') {
  return (Array.isArray(roster?.days) ? roster.days : []).find((day) => conciergeRecordDateKey({ day }) === key) || null;
}
function conciergeReplyKeyboard(value = '') {
  if (/^\/(?:start|ajuda|help|comandos|menu)(?:@\S+)?$/i.test(value)) return conciergeKeyboard;
  if (/^\/(?:configuracoes|meunome|nomeconcierge)(?:@\S+)?/i.test(value)) return conciergeSettingsKeyboard;
  return conciergeFunctionKeyboard;
}
async function conciergeIdentityFlow(text = '', profile = {}, snapshot = null) {
  const value = normalizeConciergeButtonText(text);
  const preferences = snapshot?.preferences || {};
  const premium = isPremiumConcierge(snapshot || {}, profile || {}) || Boolean(typeof cc1371IsAdmin === 'function' && cc1371IsAdmin(String(profile?.email || '').toLowerCase()));
  const command = String(value || '').trim();
  const asksSettings = /^\/configuracoes(?:@\S+)?$/i.test(command);
  const asksUserName = /^\/meunome(?:@\S+)?(?:\s|$)/i.test(command) || /^(?:me chama de|pode me chamar de)\s+/i.test(command);
  const asksConciergeName = /^\/nomeconcierge(?:@\S+)?(?:\s|$)/i.test(command) || /^nome do concierge(?:\s|$)/i.test(command);
  if (asksSettings) return { handled: true, reply: buildConciergeSettingsReply(profile, snapshot || {}), snapshot };
  if (asksUserName) {
    const proposed = cleanDisplayName(command.replace(/^\/meunome(?:@\S+)?\s*/i, '').replace(/^(?:me chama de|pode me chamar de)\s+/i, ''), '');
    if (!proposed) {
      const saved = await conciergeSaveSnapshotAsync(profile, null, { preferences: { onboardingStep: 'ask-user-name', conciergeName: preferences.conciergeName || DEFAULT_CONCIERGE_NAME } });
      return { handled: true, reply: 'Como você gostaria que eu chamasse você? Escreva somente o nome ou apelido.', snapshot: saved || snapshot };
    }
    const nextStep = premium && !preferences.conciergeNameConfirmed ? 'ask-concierge-name' : 'complete';
    const saved = await conciergeSaveSnapshotAsync(profile, null, { preferences: { preferredName: proposed, conciergeName: preferences.conciergeName || DEFAULT_CONCIERGE_NAME, onboardingStep: nextStep } });
    const follow = premium
      ? `Eu começo usando ${preferredConciergeName(saved || snapshot || {})}. Você pode manter esse nome ou escrever “nome do concierge” seguido do novo nome.`
      : `Eu vou usar ${DEFAULT_CONCIERGE_NAME} como nome do concierge. A troca desse nome fica disponível no plano Premium.`;
    return { handled: true, reply: `Fechado, ${proposed}. Vou chamar você assim daqui para a frente. ${follow}`, snapshot: saved || snapshot };
  }
  if (asksConciergeName) {
    if (!premium) return { handled: true, reply: `Por enquanto, meu nome é ${DEFAULT_CONCIERGE_NAME}. A personalização do nome do concierge é um recurso Premium e é feita somente por texto.`, snapshot };
    const proposed = cleanDisplayName(command.replace(/^\/nomeconcierge(?:@\S+)?\s*/i, '').replace(/^nome do concierge\s*/i, ''), '');
    if (!proposed) {
      const saved = await conciergeSaveSnapshotAsync(profile, null, { preferences: { onboardingStep: 'ask-concierge-name', conciergeName: preferences.conciergeName || DEFAULT_CONCIERGE_NAME } });
      return { handled: true, reply: `Qual nome você quer usar para o concierge? O nome atual é ${preferredConciergeName(saved || snapshot || {})}.`, snapshot: saved || snapshot };
    }
    const saved = await conciergeSaveSnapshotAsync(profile, null, { preferences: { conciergeName: proposed, conciergeNameConfirmed: true, onboardingStep: 'complete' } });
    return { handled: true, reply: `Combinado. A partir de agora, o concierge se chama ${proposed}. Essa configuração fica salva no seu perfil Premium.`, snapshot: saved || snapshot };
  }
  if (preferences.onboardingStep === 'ask-user-name' && command && !command.startsWith('/')) {
    const proposed = cleanDisplayName(command, '');
    const nextStep = premium ? 'ask-concierge-name' : 'complete';
    const saved = await conciergeSaveSnapshotAsync(profile, null, { preferences: { preferredName: proposed, conciergeName: preferences.conciergeName || DEFAULT_CONCIERGE_NAME, onboardingStep: nextStep } });
    const follow = premium
      ? `Eu sou ${DEFAULT_CONCIERGE_NAME}. Quer manter esse nome ou prefere outro? Escreva “nome do concierge” seguido do nome escolhido.`
      : `Eu sou ${DEFAULT_CONCIERGE_NAME}. No Premium, você pode trocar meu nome pelas configurações em texto.`;
    return { handled: true, reply: `Boa, ${proposed}. Vou chamar você assim. ${follow}`, snapshot: saved || snapshot };
  }
  if (preferences.onboardingStep === 'ask-concierge-name' && command && !command.startsWith('/')) {
    if (!premium) {
      const saved = await conciergeSaveSnapshotAsync(profile, null, { preferences: { conciergeName: DEFAULT_CONCIERGE_NAME, onboardingStep: 'complete' } });
      return { handled: true, reply: `Tudo certo. Vou continuar como ${DEFAULT_CONCIERGE_NAME}.`, snapshot: saved || snapshot };
    }
    const proposed = /manter|bruno saraiva/i.test(command) ? DEFAULT_CONCIERGE_NAME : cleanDisplayName(command, DEFAULT_CONCIERGE_NAME);
    const saved = await conciergeSaveSnapshotAsync(profile, null, { preferences: { conciergeName: proposed, conciergeNameConfirmed: true, onboardingStep: 'complete' } });
    return { handled: true, reply: `Perfeito. Pode me chamar de ${proposed}. Agora é só perguntar sobre a sua escala.`, snapshot: saved || snapshot };
  }
  if ((!preferences.preferredName || !preferences.onboardingStep) && /^\/(?:start|ajuda|help|comandos)(?:@\S+)?$/i.test(command)) {
    const saved = await conciergeSaveSnapshotAsync(profile, null, { preferences: { onboardingStep: 'ask-user-name', conciergeName: preferences.conciergeName || DEFAULT_CONCIERGE_NAME } });
    return { handled: true, reply: `Oi! Eu sou ${DEFAULT_CONCIERGE_NAME}, o concierge da sua escala. Antes de começarmos, como você gostaria que eu chamasse você? Responda somente por texto com seu nome ou apelido.`, snapshot: saved || snapshot };
  }
  return { handled: false, snapshot };
}
async function conciergePremiumScheduleReply(snapshot, mode = 'next', profile = {}) {
  const roster = snapshot?.roster;
  if (!roster?.days?.length) return `${premiumGreeting(profile, snapshot || {})} Ainda não tenho uma escala ativa. Envie o PDF oficial ou sincronize a escala pelo app.`;
  if (mode === 'summary') {
    const stats = conciergeRosterDiagnostics(roster);
    const next = conciergeNextProgram(roster);
    const opening = `${premiumGreeting(profile, snapshot)} Sua escala tem ${stats.flights} pernas distribuídas em ${stats.programs} programações.`;
    const nextSummary = next
      ? buildProgramSummary({ profile, snapshot, record: next, label: 'A próxima programação', presentationTime: conciergePresentationTime(next), includeGreeting: false })
      : 'Não encontrei uma programação futura confirmada.';
    return `${opening} ${nextSummary}`;
  }
  if (mode === 'today' || mode === 'tomorrow') {
    const offset = mode === 'tomorrow' ? 86_400_000 : 0;
    const key = conciergeDateKey(new Date(Date.now() + offset));
    const label = mode === 'today' ? 'Hoje' : 'Amanhã';
    const found = conciergeProgramRecords(roster).filter((record) => conciergeRecordDateKey(record) === key);
    if (!found.length) return buildBlankDaySummary({ profile, snapshot, day: conciergeDayForKey(roster, key), label });
    return found.map((record, index) => buildProgramSummary({
      profile,
      snapshot,
      record,
      label: index ? 'Na sequência' : label,
      presentationTime: conciergePresentationTime(record),
      includeGreeting: index === 0,
    })).join('\n');
  }
  const next = conciergeNextProgram(roster);
  return next
    ? buildProgramSummary({ profile, snapshot, record: next, label: 'A próxima programação', presentationTime: conciergePresentationTime(next) })
    : `${premiumGreeting(profile, snapshot)} Não encontrei uma programação futura confirmada na escala ativa.`;
}
async function conciergeDepartureOwnerCurrent(profile, snapshot) {
  const owner = conciergeSafeKey(profile?.email || '');
  if (!owner || !snapshot?.roster || conciergeSafeKey(snapshot.email || snapshot.key || '') !== owner
    || (snapshot.key && conciergeSafeKey(snapshot.key) !== owner) || !conciergeAccessMatches(profile, snapshot)) return false;
  if (profile.channel !== 'telegram') return true;
  if (!profile.chatId || profile.chatType !== 'private' || profile.linked !== true) return false;
  try {
    const current = await telegramProfileForChatAsync({chat:{id:profile.chatId,type:'private'},from:{id:profile.chatId}});
    return current?.linked === true && current.channel === 'telegram' && current.chatType === 'private'
      && String(current.chatId) === String(profile.chatId) && conciergeSafeKey(current.email) === owner
      && String(current.accessKeyHash || '') === String(profile.accessKeyHash || '') && conciergeAccessMatches(current, snapshot);
  } catch { return false; }
}
async function conciergePremiumDepartureReply(snapshot, profile = {}) {
  const owner = conciergeSafeKey(profile.email || '');
  const owns = candidate => Boolean(owner && conciergeSafeKey(profile.email || '') === owner && candidate?.roster
    && conciergeSafeKey(candidate.email || candidate.key || '') === owner && (!candidate.key || conciergeSafeKey(candidate.key) === owner) && conciergeAccessMatches(profile, candidate));
  if (!owns(snapshot) || !await conciergeDepartureOwnerCurrent(profile, snapshot)) return gateQuerySuppressed({reason:'account-unverified'}).message;
  const roster = snapshot?.roster;
  const record = conciergeJourneyProgramRecords(roster, conciergeProgramRecords(roster)).find((item) => {
    if (item.end < new Date()) return false;
    if (item.legs?.length) return true;
    return ['ASB', 'HSB', 'HSBE', 'MT', 'CRM', 'CBF', 'EMER'].some((code) => item.code === code || item.code.startsWith(code));
  });
  // Share the existing departure reader's non-routing policy responses. These
  // conditions return before its route boundary, preserving one canonical APZ.
  const origin = record?.legs?.[0]?.origin || record?.day?.base || '';
  const status = String(record?.day?.status || '').trim().toLowerCase();
  if (!record || record.display?.cancelled === true || ['cancelled', 'canceled', 'cancelado'].includes(status)
    || ['HSB', 'HSBE'].includes(record.code) || !roster.base || !origin
    || String(origin).toUpperCase() !== String(roster.base).toUpperCase()) return conciergeDepartureReply(snapshot);
  // The projection's display proof is the same authority used by Next. Neither
  // a classifier clock nor a legacy row report can supply a missing APZ.
  const presentationDate = record.display?.clockBasis === 'published-brt'
    && record.display.presentationConfirmed === true && Number.isFinite(record.display.publishedStart)
    ? new Date(record.display.publishedStart) : null;
  if (!presentationDate) return buildDepartureSummary({ now: Date.now(), profile, snapshot, record, origin });
  const presentation = new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit', hour12: false }).format(presentationDate);
  if (presentationDate.getTime() <= Date.now()) return buildDepartureSummary({ now: Date.now(),profile, snapshot, record, origin});
  const locationState = conciergeLocationContextV14335(snapshot);
  const location = locationState.fresh ? locationState.location : null;
  if (!location) return buildDepartureSummary({ now: Date.now(), profile, snapshot, record, origin, presentationTime: presentation });
  let route = null;
  try { route = await conciergeTravelEstimate(location, origin); } catch {
    // An unavailable route cannot replace the shared published APZ with a fallback clock.
  }
  if (!owns(snapshot) || !await conciergeDepartureOwnerCurrent(profile, snapshot)) return gateQuerySuppressed({reason:'response-context-expired'}).message;
  if (presentationDate.getTime() <= Date.now()) return buildDepartureSummary({ now: Date.now(),profile, snapshot, record, origin});
  if (!route) return buildDepartureSummary({ now: Date.now(), profile, snapshot, record, origin, presentationTime: presentation, routeState: 'unavailable' });
  if (route.distanceKm > 250) return buildDepartureSummary({ now: Date.now(), profile, snapshot, record, origin, presentationTime: presentation, route, routeState: 'long' });
  const departureWindow = calculateDepartureWindow(presentationDate, route);
  const leaveTime = new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit', hour12: false }).format(departureWindow.leave);
  const safeRoute = { ...route, minutes: departureWindow.routeMinutes, leadMinutes: departureWindow.leadMinutes };
  let radar = null;
  const firstLeg = record.legs?.[0];
  if (firstLeg) {
    const queryContext = buildFlightContext(firstLeg.flightNumber);
    const canonical = buildCanonicalRosterEvents(roster);
    const bindings = [];
    if (owns(snapshot)) for (const event of canonical) {
      if (event.kind !== 'flight' || event.id !== record.canonicalEventIds?.[0] || buildFlightContext(event.flightNumber).raw !== queryContext.raw) continue;
      const binding = findPublishedGateLeg(roster, {flight:queryContext.raw,origin:event.origin,destination:event.destination,
        eventId:event.id,departureDate:originFlightDate(event.startDateTime,event.origin),scheduledDepartureUtc:event.startDateTime}, canonical);
      if (binding?.identity.eventId === event.id && gateQueryDay(binding.identity).allowed) bindings.push(binding);
    }
    if (bindings.length !== 1) radar = gateQuerySuppressed({reason:owns(snapshot) ? 'occurrence-unverified' : 'account-unverified'});
    else {
      queryContext.gateQueryEvidence = bindings[0].identity;
      if (!await conciergeDepartureOwnerCurrent(profile, snapshot)) return gateQuerySuppressed({reason:'response-context-expired'}).message;
      radar = await runRadarRace(queryContext, firstLeg.origin || '', firstLeg.destination || '');
      const currentSnapshot = await conciergeLoadSnapshot(profile);
      if (!owns(currentSnapshot) || !await conciergeDepartureOwnerCurrent(profile, currentSnapshot) || !gateQueryDay(queryContext.gateQueryEvidence).allowed)
        return gateQuerySuppressed({reason:'response-context-expired'}).message;
      const currentBinding = findPublishedGateLeg(currentSnapshot.roster, queryContext.gateQueryEvidence, buildCanonicalRosterEvents(currentSnapshot.roster));
      if (!currentBinding) return gateQuerySuppressed({reason:'response-occurrence-changed'}).message;
      if (radar?.ok && !radar.querySuppressed) {
        conciergeApplyRadar(currentSnapshot, currentBinding, radar);
        await conciergeSaveSnapshotAsync(profile, currentSnapshot.roster, {source:currentSnapshot.source || 'departure-radar',lastRadar:{...radar,updatedAt:new Date().toISOString()}});
        if (!owns(currentSnapshot) || !await conciergeDepartureOwnerCurrent(profile, currentSnapshot) || !gateQueryDay(queryContext.gateQueryEvidence).allowed)
          return gateQuerySuppressed({reason:'response-context-expired'}).message;
      }
    }
  }
  if (!await conciergeDepartureOwnerCurrent(profile, snapshot)) return gateQuerySuppressed({reason:'response-context-expired'}).message;
  return buildDepartureSummary({ now: Date.now(), profile, snapshot, record, route: safeRoute, leaveTime, leaveEpoch: departureWindow.leave.getTime(), origin, radar, presentationTime: presentation });
}
