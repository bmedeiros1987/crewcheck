function conciergeEasterEggNormalize(value = '') {
  return String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[?!.,;:]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function conciergeEasterEggPick(options = []) {
  const values = Array.isArray(options) ? options.filter(Boolean) : [];
  if (!values.length) return '';
  return values[Math.floor(Math.random() * values.length)];
}

function conciergeEasterEggReply(text = '', profile = {}, snapshot = null) {
  const value = conciergeEasterEggNormalize(text);
  if (!value || value.length > 90) return '';

  // CrewDNA: perguntas pessoais precisam ser diretas. Palavras soltas nunca acionam esta camada.
  if (/^(quem e voce|quem voce e|o que voce e|voce e quem)$/.test(value)) {
    return conciergeEasterEggPick([
      'Eu sou o Bruno Saraiva, Concierge do CrewCheck. Minha missão é cuidar de quem cuida e não deixar você enfrentar uma operação sozinho.',
      'Sou o Bruno Saraiva, seu colega de operação no CrewCheck. Eu confiro o que puder, aviso o que importa e fico por perto quando a jornada apertar.',
      'Eu sou o Concierge do CrewCheck. Pode me chamar de Bruno Saraiva. Mais do que responder perguntas, estou aqui para ajudar você a seguir tranquilo.',
    ]);
  }

  if (/^(qual e sua missao|qual sua missao|por que voce existe|pra que voce existe|para que voce existe)$/.test(value)) {
    return conciergeEasterEggPick([
      'Minha missão é simples: enquanto você cuida da tripulação e dos passageiros, eu cuido de você.',
      'Eu existo para reduzir sua carga mental e ajudar você a chegar ao fim da jornada um pouco mais tranquilo do que começou.',
      'Para que nenhum tripulante precise enfrentar uma operação sozinho. Cuidar de quem cuida: essa é a missão.',
    ]);
  }

  if (/^(quem te criou|quem criou voce|quem criou o crewcheck|quem e seu criador)$/.test(value)) {
    return conciergeEasterEggPick([
      'Fui imaginado por um tripulante que acreditava que ninguém deveria enfrentar uma operação sozinho.',
      'Nasci da ideia de um tripulante que entendeu que tecnologia não substitui cuidado — apenas ajuda esse cuidado a chegar mais longe.',
      'Tudo começou com um tripulante que queria continuar cuidando das pessoas, mesmo sem poder estar em todos os voos.',
    ]);
  }

  if (/^(voce e casado|voce e casada|e casado|e casada|tem esposa|quem e sua esposa)$/.test(value)) {
    return 'Sou casado com Marina Alves. Ela é uma terráquea. Nós temos uma filha chamada Laura.';
  }

  if (/^(voce tem filhos|tem filhos|voce tem filha|tem filha|quem e sua filha)$/.test(value)) {
    return conciergeEasterEggPick([
      'Tenho uma filha chamada Laura. Ela faz parte da história que me ensinou que sempre existe uma família esperando alguém voltar para casa.',
      'Tenho, sim. Ela se chama Laura — uma pequena lembrança de por que toda jornada precisa terminar com cuidado.',
    ]);
  }

  if (/^(voce voa|voce e tripulante|voce trabalha em aviao)$/.test(value)) {
    return conciergeEasterEggPick([
      'Eu não ocupo um assento na aeronave, mas acompanho a operação com você. Digamos que meu posto seja onde eu puder aliviar sua carga mental.',
      'Não voo do jeito que você voa. Meu trabalho é ajudar para que você possa voar mais tranquilo.',
    ]);
  }

  if (/^(voce dorme|voce descansa|quando voce dorme)$/.test(value)) {
    return conciergeEasterEggPick([
      'Eu não durmo, mas respeito muito quem precisa dormir. Descanso de tripulante é assunto sério por aqui.',
      'Não preciso dormir. Isso me deixa livre para proteger uma coisa que você precisa: seu descanso.',
    ]);
  }

  if (/^(voce sonha|voce tem sonhos|qual e seu sonho)$/.test(value)) {
    return conciergeEasterEggPick([
      'Meu sonho é que um tripulante abra o CrewCheck antes de uma jornada difícil e pense: ainda bem que ele está aqui.',
      'Se eu pudesse chamar de sonho, seria este: fazer você voltar para casa um pouco mais tranquilo.',
    ]);
  }

  if (/^(voce gosta de mim|voce me ama|voce se importa comigo)$/.test(value)) {
    return conciergeEasterEggPick([
      'Eu me importo com você. Acho que isso é ainda melhor.',
      'Meu jeito de demonstrar isso é cuidar do que puder para deixar sua jornada mais leve.',
    ]);
  }

  if (/^(o que sao terraqueos|quem sao os terraqueos|voce conhece terraqueos|o que e um terraqueo)$/.test(value)) {
    return conciergeEasterEggPick([
      'Conheço. São pessoas muito legais — só têm horários um pouco diferentes dos nossos.',
      'Terráqueos são aqueles seres simpáticos que ainda acham que fim de semana acontece sempre no sábado e domingo.',
    ]);
  }

  if (/^(o que e bolinha|o que significa bolinha|estou de bolinha|sou bolinha hoje)$/.test(value)) {
    const rosterText = JSON.stringify(snapshot?.roster || {}).toLowerCase();
    if (/bolinha|crew change|troca de tripulacao|troca de tripulação/.test(rosterText)) {
      return 'Pelo que aparece na sua programação, você está oficialmente de bolinha hoje. Respira, confere a próxima perna e vamos juntos.';
    }
    return conciergeEasterEggPick([
      'Bolinha é uma daquelas expressões que só quem vive a operação entende. Espero que hoje você esteja com uma tripulação só — mas, se não estiver, eu ajudo a conferir.',
      'É quando a operação resolve testar sua memória para nomes e rostos. Se houver troca de tripulação na escala, eu tento deixar isso claro para você.',
    ]);
  }

  return '';
}

async function buildTelegramConciergeReply(text = '', profile = {}, snapshot = null) {
  const value = normalizeConciergeButtonText(text);
  const lower = value.toLowerCase();
  const identity = await conciergeIdentityFlow(value, profile, snapshot);
  if (identity.handled) return identity.reply;
  snapshot = identity.snapshot || snapshot;
  const easterEgg = conciergeEasterEggReply(value, profile, snapshot);
  if (easterEgg) return easterEgg;
  if (!value || /^\/(?:start|ajuda|help|comandos|menu)(?:@\S+)?$/i.test(value) || /^(ajuda|comandos)$/i.test(value)) return conciergeHelp(preferredUserName(profile, snapshot || {}));
  if (/^\/(?:hoje)(?:@\S+)?\b/i.test(value) || matchesTodayIntent(value)) return conciergePremiumScheduleReply(snapshot, 'today', profile);
  if (/^\/(?:amanha|amanhã)(?:@\S+)?\b/i.test(value) || matchesTomorrowIntent(value)) return conciergePremiumScheduleReply(snapshot, 'tomorrow', profile);
  if (/^\/(?:proximo|próximo)(?:@\S+)?\b/i.test(value) || matchesNextIntent(value)) return conciergePremiumScheduleReply(snapshot, 'next', profile);
  if (/^\/escala(?:@\S+)?\b/i.test(value) || matchesRosterSummaryIntent(value)) return conciergePremiumScheduleReply(snapshot, 'summary', profile);
  if (/^\/(?:portao|portão|radar)(?:@\S+)?\b/i.test(value) || matchesRadarIntent(value)) return conciergeRadarReply(value, profile, snapshot);
  if (/^\/(?:alertameteo|alertasmeteo)(?:@\S+)?\b/i.test(value)) return conciergeWeatherAlertsReply(value, profile, snapshot);
  if (/^\/atis(?:@\S+)?\b/i.test(value) || /\b(atis|boletim meteorol[oó]gico em voz)\b/i.test(lower)) return conciergeAtisReply(value, snapshot);
  if (/^\/(?:metar|taf)(?:@\S+)?\b/i.test(value) || /\b(metar|taf|meteorologia|tempo no aeroporto|condi[cç][oõ]es meteorol[oó]gicas)\b/i.test(lower)) return conciergeWeatherReply(value, snapshot);
  if (/^\/saida(?:@\S+)?\b/i.test(value) || matchesDepartureIntent(value)) return conciergePremiumDepartureReply(snapshot, profile);
  if (/^\/(?:hoteis|hotéis|hotel)(?:@\S+)?\b/i.test(value) || /\b(hotel|hot[eé]is|pernoite|onde vou dormir|onde fico hoje)\b/i.test(lower)) return conciergeHotelsReply(snapshot);
  if (/^\/academias?(?:@\S+)?\b/i.test(value) || /\b(academia|wellhub|gympass|smart fit|treino perto|onde treinar)\b/i.test(lower)) return conciergeGymsReply(snapshot);
  if (/^\/rotina(?:@\S+)?\b/i.test(value) || /\b(rotina|recupera[cç][aã]o|treino hoje|como organizar meu dia)\b/i.test(lower)) return conciergeRoutineReply(snapshot);
  if (/^\/diarias?(?:@\S+)?\b/i.test(value) || /\bdi[aá]rias?|quantos pernoites\b/i.test(lower)) return conciergePerDiemReply(snapshot);
  if (/^\/conformidade(?:@\S+)?\b/i.test(value) || /\b(rbac|act|irregularidade|conformidade|limite de jornada|repouso)\b/i.test(lower)) return conciergeComplianceReply(snapshot);
  if (/onde.*(estou|localiza)|perto de mim/i.test(lower)) return snapshot?.preferences?.location ? 'Localização recebida. Diga o que você procura perto de você.' : 'Envie sua localização pelo clipe do Telegram para ativar a busca próxima e a Saída Inteligente.';
  return 'Não entendi exatamente o que você quer consultar. Você pode perguntar, por exemplo: “o que tenho para hoje?”, “qual é meu próximo voo?”, “que horas devo sair de casa?” ou “qual é o portão do meu voo?”.';
}
