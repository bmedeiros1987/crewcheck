<?xml version="1.0" encoding="utf-8"?>
<!--
  CrewCheck Pulse Free — round-first Watch Face Format face for Galaxy Watch / Wear OS 4+.

  Product rule:
  - the watch face is useful on its own for free users;
  - it never depends on the Premium CrewWatch APK to render time, date, steps, battery
    or the next system event;
  - Premium users can still choose CrewCheck complication providers manually in the
    watch-face editor after installing the CrewWatch app.

  The design is intentionally round-first and uses only resource XML, which keeps this
  bundle independent from the Wear application bundle.
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="18:16:00" />

    <Scene backgroundColor="#FF030A16">
        <!-- Premium circular identity ring. Hidden in ambient mode. -->
        <PartDraw x="24" y="24" width="402" height="402">
            <Ellipse x="0" y="0" width="402" height="402">
                <Stroke thickness="5" color="#CC22D3EE" />
            </Ellipse>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>
        <PartDraw x="31" y="31" width="388" height="388">
            <Ellipse x="0" y="0" width="388" height="388">
                <Stroke thickness="3" color="#995B5CF6" />
            </Ellipse>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>

        <!-- Restrained brand signature. -->
        <PartText x="0" y="45" width="450" height="26">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="17" weight="BOLD" color="#FF22D3EE"><![CDATA[CREWCHECK]]></Font>
            </Text>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartText>

        <!-- Time owns the face. -->
        <DigitalClock x="0" y="0" width="450" height="450">
            <TimeText
                x="0"
                y="76"
                width="450"
                height="102"
                alpha="255"
                align="CENTER"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE">
                <Font family="SYNC_TO_DEVICE" size="92" weight="BOLD" slant="NORMAL" color="#FFFFFFFF" />
                <Variant mode="AMBIENT" target="alpha" value="0" />
            </TimeText>

            <TimeText
                x="0"
                y="86"
                width="450"
                height="92"
                alpha="0"
                align="CENTER"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE">
                <Font family="SYNC_TO_DEVICE" size="84" weight="THIN" slant="NORMAL" color="#FFDDE3EC" />
                <Variant mode="AMBIENT" target="alpha" value="255" />
            </TimeText>

            <TimeText
                x="0"
                y="177"
                width="450"
                height="28"
                alpha="255"
                align="CENTER"
                format="EEE dd MMM"
                hourFormat="SYNC_TO_DEVICE">
                <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" slant="NORMAL" color="#FFA78BFA" />
            </TimeText>
        </DigitalClock>

        <!-- Free complication: steps. -->
        <ComplicationSlot
            x="78"
            y="220"
            width="132"
            height="72"
            slotId="1"
            displayName="steps_label"
            supportedTypes="SHORT_TEXT EMPTY">
            <BoundingRoundBox x="0" y="0" width="132" height="72" outlinePadding="2.0" cornerRadius="34" />
            <DefaultProviderPolicy
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="4" y="5" width="124" height="18">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="12" weight="NORMAL" color="#FF7D8DA6">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
                <PartText x="4" y="24" width="124" height="40">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="26" weight="BOLD" color="#FF22D3EE">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- Free complication: battery. -->
        <ComplicationSlot
            x="240"
            y="220"
            width="132"
            height="72"
            slotId="2"
            displayName="battery_label"
            supportedTypes="SHORT_TEXT EMPTY">
            <BoundingRoundBox x="0" y="0" width="132" height="72" outlinePadding="2.0" cornerRadius="34" />
            <DefaultProviderPolicy
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="4" y="5" width="124" height="18">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="12" weight="NORMAL" color="#FF7D8DA6">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
                <PartText x="4" y="24" width="124" height="40">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="26" weight="BOLD" color="#FF34D399">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!--
          Free, useful third slot: next calendar event. Users can customize this slot.
          Premium customers may choose "CrewCheck · Próximo passo" here after installing
          the CrewWatch APK, without coupling the free face bundle to the paid app.
        -->
        <ComplicationSlot
            x="58"
            y="310"
            width="334"
            height="88"
            slotId="3"
            displayName="next_event_label"
            supportedTypes="LONG_TEXT SHORT_TEXT EMPTY">
            <BoundingRoundBox x="0" y="0" width="334" height="88" outlinePadding="2.0" cornerRadius="30" />
            <DefaultProviderPolicy
                defaultSystemProvider="NEXT_EVENT"
                defaultSystemProviderType="LONG_TEXT" />

            <Complication type="LONG_TEXT">
                <PartText x="12" y="7" width="310" height="22">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" color="#FF7D8DA6">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
                <PartText x="12" y="31" width="310" height="48">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="21" weight="BOLD" color="#FFFFFFFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
            </Complication>

            <Complication type="SHORT_TEXT">
                <PartText x="12" y="11" width="310" height="22">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" color="#FF7D8DA6">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
                <PartText x="12" y="35" width="310" height="42">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="25" weight="BOLD" color="#FFFFFFFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
            </Complication>
        </ComplicationSlot>

        <PartText x="0" y="408" width="450" height="20">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="11" weight="NORMAL" color="#FF53657D"><![CDATA[WE DO CARE ABOUT US]]></Font>
            </Text>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartText>
    </Scene>
</WatchFace>
