<?xml version="1.0" encoding="utf-8"?>
<!--
  CrewCheck Flight Deck — mostrador Watch Face Format v1, tela redonda 450x450.

  Linguagem: a mesma do app do relógio. Preto verdadeiro, superfícies chapadas #1C1C1E sem
  contorno, texto branco, rótulo cinza e UM acento — o ciano da marca. A única outra cor é o
  âmbar do portão, porque portão é o dado que manda você andar. Cor aqui tem função; quando
  cada quadro tinha o seu tom, nada se destacava.

  Hierarquia, de cima para baixo: portão e bateria, a hora, a data, o próximo passo e três
  leituras rápidas (CrewLife, passos, rotina).

  Geometria: tudo cabe dentro do círculo de raio 225 com folga — inclusive os cantos
  arredondados. A doca inferior anterior (x=48, 104 de largura, até y=406) tinha os cantos
  cortados pela moldura redonda. scripts/regression-watchface-premium-layout.mjs mede cada
  retângulo contra o círculo, com os cantos, e reprova o que encostar.

  Especificação: validado contra o XSD oficial do WFF v1 (github.com/google/watchface).
  Dois pontos que ele pega e que já estiveram errados aqui:
  - dentro de TimeText, Variant vem ANTES da Font (xs:sequence);
  - TimeText só aceita hora/minuto/segundo no format. Data é PartText com [DAY_OF_WEEK_S],
    [DAY_Z] e [MONTH_S]; "EEE dd MMM" não é um formato válido e não desenha nada.

  Ambiente (always-on): ficam a hora em traço fino, a data em cinza, o portão e o texto do
  próximo passo — o que interessa num voo. Superfícies, marca, bateria e as leituras de
  saúde e rotina somem: dado de saúde não fica aceso numa tela que quem está do lado vê.

  Contrato dos slots: ids 1–6, providers e tipos intactos. O slot 1 mantém o provider
  histórico (CrewCheckComplicationService) porque há instalações configuradas contra ele.
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="18:16:00" />

    <Scene backgroundColor="#FF000000">
        <!--
          Flight-deck cardinal markers: identidade de instrumento sem poluir o mostrador.
          Só o índice das 12 leva o acento; os outros três são neutros.
        -->
        <PartDraw x="221" y="10" width="8" height="20">
            <RoundRectangle x="0" y="0" width="8" height="20" cornerRadiusX="4" cornerRadiusY="4">
                <Fill color="#FF22D3EE" />
            </RoundRectangle>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>

        <PartDraw x="10" y="221" width="20" height="8">
            <RoundRectangle x="0" y="0" width="20" height="8" cornerRadiusX="4" cornerRadiusY="4">
                <Fill color="#FF3A3A3C" />
            </RoundRectangle>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>

        <PartDraw x="420" y="221" width="20" height="8">
            <RoundRectangle x="0" y="0" width="20" height="8" cornerRadiusX="4" cornerRadiusY="4">
                <Fill color="#FF3A3A3C" />
            </RoundRectangle>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>

        <PartDraw x="221" y="420" width="8" height="20">
            <RoundRectangle x="0" y="0" width="8" height="20" cornerRadiusX="4" cornerRadiusY="4">
                <Fill color="#FF3A3A3C" />
            </RoundRectangle>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>

        <!-- Assinatura discreta: a marca aparece, mas não compete com a hora. -->
        <PartText x="0" y="32" width="450" height="18">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="12" weight="SEMI_BOLD" color="#FF8E8E93"><![CDATA[CREWCHECK]]></Font>
            </Text>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartText>

        <!-- ===== Faixa superior: portão + bateria ===== -->

        <PartDraw x="80" y="58" width="130" height="36">
            <RoundRectangle x="0" y="0" width="130" height="36" cornerRadiusX="18" cornerRadiusY="18">
                <Fill color="#FF1C1C1E" />
            </RoundRectangle>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>

        <ComplicationSlot
            x="80"
            y="58"
            width="130"
            height="36"
            slotId="2"
            displayName="gate_label"
            supportedTypes="SHORT_TEXT EMPTY">
            <BoundingRoundBox x="0" y="0" width="130" height="36" outlinePadding="2.0" cornerRadius="18" />
            <DefaultProviderPolicy
                primaryProvider="com.crewcheck.app/com.crewcheck.watch.GateComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="8" y="5" width="114" height="26">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="17" weight="BOLD" color="#FFFBBF24">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <PartDraw x="240" y="58" width="130" height="36">
            <RoundRectangle x="0" y="0" width="130" height="36" cornerRadiusX="18" cornerRadiusY="18">
                <Fill color="#FF1C1C1E" />
            </RoundRectangle>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>

        <ComplicationSlot
            x="240"
            y="58"
            width="130"
            height="36"
            slotId="5"
            displayName="battery_label"
            supportedTypes="SHORT_TEXT EMPTY">
            <BoundingRoundBox x="0" y="0" width="130" height="36" outlinePadding="2.0" cornerRadius="18" />
            <DefaultProviderPolicy
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="8" y="5" width="114" height="26">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="SEMI_BOLD" color="#FFC7C7CC">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ===== Hora: o herói, direto sobre o preto, sem moldura ===== -->

        <DigitalClock x="0" y="0" width="450" height="450">
            <!-- Interativo: numeral cheio. -->
            <TimeText
                x="0"
                y="98"
                width="450"
                height="100"
                alpha="255"
                align="CENTER"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Font family="SYNC_TO_DEVICE" size="92" weight="BOLD" slant="NORMAL" color="#FFFFFFFF" />
            </TimeText>

            <!-- Ambiente: o mesmo numeral em traço fino — menos pixel aceso no OLED. -->
            <TimeText
                x="0"
                y="104"
                width="450"
                height="92"
                alpha="0"
                align="CENTER"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Font family="SYNC_TO_DEVICE" size="84" weight="THIN" slant="NORMAL" color="#FFDDE3EC" />
            </TimeText>
        </DigitalClock>

        <!--
          Data. TimeText não formata data (o format só aceita h/m/s), então é PartText com
          as fontes de dado do calendário, no idioma do relógio: "SEX 25 SET".
          Interativo em ciano; ambiente em cinza, sem cor acesa.
        -->
        <PartText x="0" y="198" width="450" height="24" alpha="255">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="17" weight="SEMI_BOLD" color="#FF22D3EE">
                    <Upper><Template><![CDATA[%s %s %s]]><Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY_Z]" /><Parameter expression="[MONTH_S]" /></Template></Upper>
                </Font>
            </Text>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartText>

        <PartText x="0" y="198" width="450" height="24" alpha="0">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="17" weight="NORMAL" color="#FF8E8E93">
                    <Upper><Template><![CDATA[%s %s %s]]><Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY_Z]" /><Parameter expression="[MONTH_S]" /></Template></Upper>
                </Font>
            </Text>
            <Variant mode="AMBIENT" target="alpha" value="255" />
        </PartText>

        <!-- ===== Próximo passo: o cartão operacional ===== -->

        <PartDraw x="40" y="230" width="370" height="96">
            <RoundRectangle x="0" y="0" width="370" height="96" cornerRadiusX="30" cornerRadiusY="30">
                <Fill color="#FF1C1C1E" />
            </RoundRectangle>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>

        <PartDraw x="54" y="252" width="4" height="52">
            <RoundRectangle x="0" y="0" width="4" height="52" cornerRadiusX="2" cornerRadiusY="2">
                <Fill color="#FF22D3EE" />
            </RoundRectangle>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>

        <ComplicationSlot
            x="40"
            y="230"
            width="370"
            height="96"
            slotId="1"
            displayName="next_step_label"
            supportedTypes="LONG_TEXT SHORT_TEXT EMPTY">
            <BoundingRoundBox x="0" y="0" width="370" height="96" outlinePadding="2.0" cornerRadius="30" />

            <!-- Provider histórico de propósito: há instalações já configuradas contra ele. -->
            <DefaultProviderPolicy
                primaryProvider="com.crewcheck.app/com.crewcheck.watch.CrewCheckComplicationService"
                primaryProviderType="LONG_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />

            <Complication type="LONG_TEXT">
                <PartText x="28" y="12" width="314" height="22">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="15" weight="SEMI_BOLD" color="#FF22D3EE">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
                <PartText x="28" y="36" width="314" height="50">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="26" weight="BOLD" color="#FFFFFFFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="SHORT_TEXT">
                <PartText x="28" y="12" width="314" height="22">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="15" weight="SEMI_BOLD" color="#FF22D3EE">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
                <PartText x="28" y="36" width="314" height="50">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#FFFFFFFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ===== Doca inferior: CrewLife + passos + rotina ===== -->

        <PartDraw x="71" y="334" width="96" height="60">
            <RoundRectangle x="0" y="0" width="96" height="60" cornerRadiusX="22" cornerRadiusY="22">
                <Fill color="#FF1C1C1E" />
            </RoundRectangle>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>

        <ComplicationSlot
            x="71"
            y="334"
            width="96"
            height="60"
            slotId="3"
            displayName="crewlife_label"
            supportedTypes="SHORT_TEXT EMPTY">
            <BoundingRoundBox x="0" y="0" width="96" height="60" outlinePadding="2.0" cornerRadius="22" />
            <DefaultProviderPolicy
                primaryProvider="com.crewcheck.app/com.crewcheck.watch.CrewLifeComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="4" y="6" width="88" height="18">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="13" weight="SEMI_BOLD" color="#FF8E8E93">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
                <PartText x="4" y="24" width="88" height="30">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="#FFFFFFFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
            </Complication>
        </ComplicationSlot>

        <PartDraw x="177" y="334" width="96" height="60">
            <RoundRectangle x="0" y="0" width="96" height="60" cornerRadiusX="22" cornerRadiusY="22">
                <Fill color="#FF1C1C1E" />
            </RoundRectangle>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>

        <ComplicationSlot
            x="177"
            y="334"
            width="96"
            height="60"
            slotId="6"
            displayName="steps_label"
            supportedTypes="SHORT_TEXT EMPTY">
            <BoundingRoundBox x="0" y="0" width="96" height="60" outlinePadding="2.0" cornerRadius="22" />
            <DefaultProviderPolicy
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="4" y="6" width="88" height="18">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="13" weight="SEMI_BOLD" color="#FF8E8E93">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
                <PartText x="4" y="24" width="88" height="30">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="#FFFFFFFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
            </Complication>
        </ComplicationSlot>

        <PartDraw x="283" y="334" width="96" height="60">
            <RoundRectangle x="0" y="0" width="96" height="60" cornerRadiusX="22" cornerRadiusY="22">
                <Fill color="#FF1C1C1E" />
            </RoundRectangle>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>

        <ComplicationSlot
            x="283"
            y="334"
            width="96"
            height="60"
            slotId="4"
            displayName="routine_label"
            supportedTypes="SHORT_TEXT EMPTY">
            <BoundingRoundBox x="0" y="0" width="96" height="60" outlinePadding="2.0" cornerRadius="22" />
            <DefaultProviderPolicy
                primaryProvider="com.crewcheck.app/com.crewcheck.watch.RoutineComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="4" y="6" width="88" height="18">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="13" weight="SEMI_BOLD" color="#FF8E8E93">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
                <PartText x="4" y="24" width="88" height="30">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="#FFFFFFFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
