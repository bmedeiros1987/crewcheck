<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <!--
          Preto puro: as Diretrizes de qualidade de apps para Wear exigem fundo
          preto, e o #050B14 anterior foi recusado pela revisão do Play em
          24/09/2026 ("o segundo plano não é preto").
        -->
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorAccent">#22D3EE</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
