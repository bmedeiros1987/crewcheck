  // Both legacy Base64 APKs and the #825 private-inbox bridge use this importer.
  const nativePdfClaimsRef = useRef<Set<string>>(new Set());
  function captureSharedPdfImport(isAlive: () => boolean) {
    const capturedOwner = publicationOwner();
    const capturedReference = currentPublicationReview()?.publication.revision ?? null;
    const plannedImport = beginOwnedPlannedImport();
    const choice = beginRosterChoice();
    let finished = false;
    const canCommit = Object.assign(() => choice(), { finish() {
      if (!finished) { finished = true; choice.finish(); }
    } });
    return { importOwner: capturedOwner, importReference: capturedReference, plannedImport, canCommit, isAlive };
  }
  useEffect(() => {
    let alive = true;
    const consumeNativePdf = async (payload: any) => {
      if (!alive) return;
      const filename = String(payload?.filename || payload?.sourceFileName || 'CrewCheck-escala.pdf').trim() || 'CrewCheck-escala.pdf';
      const dataBase64 = String(payload?.dataBase64 || '').trim();
      const shareId = String(payload?.shareId || (dataBase64 ? `legacy:${filename}:${dataBase64.length}` : '')).trim();
      if (!shareId || nativePdfClaimsRef.current.has(shareId)) return;
      // Capture account, publication and choice BEFORE reading the shared file.
      const context = captureSharedPdfImport(() => alive);
      const current = () => alive && context.plannedImport.canCommit() && context.canCommit()
        && context.importOwner === publicationOwner();
      if (!current()) { context.canCommit.finish(); return; }
      nativePdfClaimsRef.current.add(shareId);
      let acknowledged = false;
      try {
        const maxBytes = 35 * 1024 * 1024;
        let bytes: Uint8Array;
        if (dataBase64) {
          if (dataBase64.length > Math.ceil(maxBytes / 3) * 4) throw new Error('PDF maior que 35 MB.');
          const binary = window.atob(dataBase64);
          bytes = Uint8Array.from(binary, (character) => character.charCodeAt(0));
        } else {
          const expectedLength = Number(payload?.byteLength);
          const bridge = (window as any).AndroidCrewCheckNative;
          if (payload?.transport !== 'android-private-inbox' || !Number.isInteger(expectedLength)
            || expectedLength <= 0 || expectedLength > maxBytes || typeof bridge?.readSharedPdfChunk !== 'function') {
            throw new Error('Não consegui ler o PDF compartilhado do armazenamento local.');
          }
          bytes = new Uint8Array(expectedLength);
          let offset = 0;
          while (offset < expectedLength) {
            if (!current()) return;
            const requested = Math.min(192 * 1024, expectedLength - offset);
            const encoded = String(bridge.readSharedPdfChunk(shareId, String(offset), String(requested)) || '');
            if (!encoded || encoded.length > Math.ceil(requested / 3) * 4) throw new Error('O PDF compartilhado retornou um bloco inválido.');
            const binary = window.atob(encoded);
            if (!binary.length || binary.length > requested) throw new Error('O PDF compartilhado retornou um bloco inválido.');
            for (let index = 0; index < binary.length; index += 1) bytes[offset + index] = binary.charCodeAt(index);
            offset += binary.length;
          }
        }
        if (!current()) return;
        if (bytes.length > maxBytes || bytes.length < 5 || bytes[0] !== 0x25 || bytes[1] !== 0x50
          || bytes[2] !== 0x44 || bytes[3] !== 0x46 || bytes[4] !== 0x2d) {
          throw new Error('O arquivo compartilhado não parece ser um PDF válido.');
        }
        const file = new File([bytes], filename.toLowerCase().endsWith('.pdf') ? filename : `${filename}.pdf`, { type: 'application/pdf' });
        toast.message('PDF compartilhado recebido. Importando escala...');
        const committed = await handleFile({ target: { files: [file] } } as unknown as ChangeEvent<HTMLInputElement>, context);
        // A successful setBundle can replace this effect. That is not a failed import.
        if (committed !== true || !context.plannedImport.canCommit() || !context.canCommit()
          || context.importOwner !== publicationOwner()) return;
        acknowledged = (window as any).AndroidCrewCheckNative?.acknowledgeSharedPdf?.(shareId) === true;
        const pending = (window as any).__crewcheckPendingNativePdf;
        if (acknowledged && (pending === payload || (pending?.shareId && pending.shareId === shareId))) {
          delete (window as any).__crewcheckPendingNativePdf;
        }
      } catch (error) {
        if (current()) {
          toast.error(error instanceof Error ? error.message : 'Não consegui importar o PDF compartilhado.');
          setView('import');
        }
      } finally {
        context.canCommit.finish();
        if (!acknowledged) nativePdfClaimsRef.current.delete(shareId);
      }
    };
    const onNativePdf = (event: Event) => { void consumeNativePdf((event as CustomEvent).detail); };
    window.addEventListener('crewcheck:native-pdf', onNativePdf as EventListener);
    const pending = (window as any).__crewcheckPendingNativePdf;
    if (pending) window.setTimeout(() => { void consumeNativePdf(pending); }, 0);
    return () => { alive = false; window.removeEventListener('crewcheck:native-pdf', onNativePdf as EventListener); };
  }, [bundle]);
