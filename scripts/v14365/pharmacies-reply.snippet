async function conciergePharmaciesReply(snapshot) {
  const locationState = conciergeLocationContextV14335(snapshot);
  if (!locationState.fresh) return locationState.message;
  const places = await conciergeSearchNearbyHealthPlaces(['pharmacy'], locationState.location, 6);
  if (!places.length) return `Não encontrei farmácias próximas agora. ${conciergeLocationLineV14335(snapshot)} Tente novamente ou abra o mapa do aparelho.`;
  return [
    'Farmácias próximas',
    conciergeLocationLineV14335(snapshot),
    '',
    conciergePlaceLines(places),
    '',
    conciergeHealthRouteLines(places),
    '',
    'A busca usa exclusivamente a localização recente compartilhada e descarta qualquer resultado fora da região.',
  ].filter((line) => line !== '').join('\n');
}
