async function conciergeSearchNearbyHealthPlaces(includedTypes = [], location = null, maxResultCount = 6) {
  const key = mapsServerKey();
  if (!key) return [];
  const locationState = conciergeLocationStateV14335(location, { airportPoints: WEATHER_AIRPORT_POINTS });
  if (!locationState.fresh || !locationState.location) return [];
  const current = locationState.location;
  try {
    const response = await fetch('https://places.googleapis.com/v1/places:searchNearby', {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        'X-Goog-Api-Key': key,
        'X-Goog-FieldMask': 'places.displayName,places.formattedAddress,places.rating,places.googleMapsUri,places.currentOpeningHours.openNow,places.location',
      },
      body: JSON.stringify({
        includedTypes: Array.from(new Set(includedTypes.map((value) => String(value || '').trim()).filter(Boolean))),
        maxResultCount,
        rankPreference: 'DISTANCE',
        languageCode: 'pt-BR',
        locationRestriction: {
          circle: {
            center: { latitude: Number(current.latitude), longitude: Number(current.longitude) },
            radius: 15000,
          },
        },
      }),
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) return [];
    const places = (Array.isArray(payload?.places) ? payload.places : []).map((place) => {
      const point = place?.location ? {
        latitude: Number(place.location.latitude),
        longitude: Number(place.location.longitude),
      } : null;
      return {
        name: place?.displayName?.text || 'Local',
        address: place?.formattedAddress || '',
        rating: Number(place?.rating || 0),
        mapsUrl: place?.googleMapsUri || '',
        openNow: place?.currentOpeningHours?.openNow,
        location: point,
        distanceKm: conciergeLocationDistanceKmV14335(current, point),
      };
    });
    return filterConciergePlacesByLocationV14335(places, current, 35).slice(0, maxResultCount);
  } catch {
    return [];
  }
}
