async function conciergeTravelEstimate(location, airport) {
  const point = WEATHER_AIRPORT_POINTS[String(airport || '').toUpperCase()];
  if (!location || !point) return null;
  const origin = `${Number(location.latitude)},${Number(location.longitude)}`;
  const destination = `${point.lat},${point.lon}`;
  const googleKey = mapsServerKey();
  const tomtomKey = tomtomServerKey();
  try {
    const tomtom = tomtomKey ? await tomtomRoutePreview(origin, destination, tomtomKey) : null;
    if (tomtom?.ok && Number(tomtom.distanceMeters) > 0 && Number(tomtom.durationSeconds) > 0) return {
      distanceKm: Number(tomtom.distanceMeters) / 1000,
      minutes: Math.max(1, Math.round(Number(tomtom.durationSeconds) / 60)),
      trafficAware: true,
      distanceText: tomtom.distanceText || formatMeters(tomtom.distanceMeters),
      durationText: tomtom.durationText || formatDuration(`${tomtom.durationSeconds}s`),
      provider: 'TomTom',
      fallback: false,
      mapsBudget: await googleMapsBudgetStatus(),
    };

    const google = googleKey ? await googleRoutePreview(origin, destination, 'driving', googleKey) : null;
    if (google?.ok && Number(google.distanceMeters) > 0 && Number(google.durationSeconds) > 0) return {
      distanceKm: Number(google.distanceMeters) / 1000,
      minutes: Math.max(1, Math.round(Number(google.durationSeconds) / 60)),
      trafficAware: true,
      distanceText: google.distanceText || formatMeters(google.distanceMeters),
      durationText: google.durationText || formatDuration(`${google.durationSeconds}s`),
      provider: 'Google Routes',
      fallback: Boolean(tomtomKey),
      mapsBudget: google.mapsBudget,
    };
  } catch {}
  return null;
}
