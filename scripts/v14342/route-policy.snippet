async function googleRoutePreview(origin, destination, requestedMode, key) {
  const cached = readGoogleRouteCache(origin, destination, requestedMode);
  if (cached) return { ...cached, mapsBudget: await googleMapsBudgetStatus(), providerOrder: requestedMode === 'transit' ? ['Google Routes'] : ['TomTom', 'Google Routes'] };
  const budget = await reserveGoogleMapsRequest('routes', 1);
  if (!budget.allowed) return { ok: false, configured: true, budgetDenied: true, failureClass: 'quota', mapsBudget: budget, message: 'Limite mensal do Google Maps atingido.' };
  const travelMode = requestedMode === 'transit' ? 'TRANSIT' : 'DRIVE';
  const result = await fetchRouteJson('https://routes.googleapis.com/directions/v2:computeRoutes', {
    method: 'POST',
    headers: {
      'content-type': 'application/json',
      'X-Goog-Api-Key': key,
      'X-Goog-FieldMask': 'routes.duration,routes.staticDuration,routes.distanceMeters,routes.polyline.encodedPolyline,routes.localizedValues',
    },
    body: JSON.stringify({
      origin: { address: origin },
      destination: { address: destination },
      travelMode,
      ...(travelMode === 'DRIVE' ? { routingPreference: 'TRAFFIC_AWARE' } : {}),
      computeAlternativeRoutes: false,
      languageCode: 'pt-BR',
      units: 'METRIC',
    }),
  });
  if (googleMapsQuotaFailure(result.status, result.payload)) {
    const blocked = await markGoogleMapsQuotaBlocked(`provider_quota_${result.status || 'unknown'}`);
    return { ok: false, configured: true, quotaFailure: true, failureClass: 'quota', httpStatus: Number(result.status) || null, mapsBudget: blocked, message: 'Cota do Google Maps indisponível.' };
  }
  const route = result.payload?.routes?.[0];
  if (!result.ok || !route) return {
    ok: false,
    configured: true,
    googleFailure: true,
    httpStatus: Number(result.status) || null,
    failureClass: result.status === 401 || result.status === 403
      ? 'auth_or_restriction'
      : result.status === 400
        ? 'request_or_api'
        : result.status >= 500
          ? 'provider_unavailable'
          : 'unknown',
    mapsBudget: await googleMapsBudgetStatus(),
    message: 'Google Routes não respondeu.',
  };
  const durationSeconds = routeDurationSeconds(route.duration);
  const baselineDurationSeconds = routeDurationSeconds(route.staticDuration);
  const trafficDelaySeconds = Math.max(0, durationSeconds - baselineDurationSeconds);
  const value = {
    ok: true,
    configured: true,
    provider: 'Google Routes',
    providerOrder: travelMode === 'TRANSIT' ? ['Google Routes'] : ['TomTom', 'Google Routes'],
    fallback: travelMode === 'DRIVE',
    fallbackFrom: travelMode === 'DRIVE' ? 'TomTom' : undefined,
    liveTraffic: travelMode === 'DRIVE',
    trafficAware: travelMode === 'DRIVE',
    distanceMeters: route.distanceMeters || 0,
    distanceText: route.localizedValues?.distance?.text || formatMeters(route.distanceMeters),
    durationText: route.localizedValues?.duration?.text || formatDuration(route.duration),
    durationInTrafficText: route.localizedValues?.duration?.text || formatDuration(route.duration),
    durationSeconds,
    baselineDurationSeconds,
    trafficDelaySeconds,
    trafficDelayText: trafficDelaySeconds ? formatDuration(`${trafficDelaySeconds}s`) : 'Sem atraso relevante',
    incidents: [],
    hasRoadClosure: false,
    polyline: route.polyline?.encodedPolyline || '',
    updatedAt: new Date().toISOString(),
    refreshAfterSeconds: 120,
    message: travelMode === 'DRIVE' ? 'Rota Google calculada como contingência com trânsito quando disponível.' : 'Rota de transporte público calculada pelo Google dentro do CrewCheck.',
    mapsBudget: await googleMapsBudgetStatus(),
  };
  writeGoogleRouteCache(origin, destination, requestedMode, value);
  return value;
}
async function handleRoutePreview(req, res, url) {
  if (req.method !== 'GET') return sendJson(res, 405, { ok: false, message: 'Método não permitido.' });
  const session = cc1371Verify(cc1371RequestToken(req));
  if (cc1371AuthRequired() && !session) return sendJson(res, 401, { ok: false, authenticated: false, message: 'Sessão necessária para calcular a rota.' });
  const googleKey = mapsServerKey();
  const tomtomKey = tomtomServerKey();
  const origin = String(url.searchParams.get('origin') || '').trim();
  const destination = String(url.searchParams.get('destination') || '').trim();
  const requestedMode = String(url.searchParams.get('mode') || 'driving').toLowerCase();
  if (!origin || !destination) return sendJson(res, 400, { ok: false, message: 'Origem e destino são necessários.' });
  if (!googleKey && !tomtomKey) return sendJson(res, 200, { ok: false, configured: false, message: 'Rota ao vivo aguarda uma chave Google Routes ou TomTom.' });
  try {
    if (requestedMode !== 'transit' && tomtomKey) {
      const route = await tomtomRoutePreview(origin, destination, tomtomKey);
      if (route?.ok) return sendJson(res, 200, {
        ...route,
        provider: 'TomTom',
        providerOrder: ['TomTom', 'Google Routes'],
        fallback: false,
        mapsBudget: await googleMapsBudgetStatus(),
        learningEligible: true,
        message: 'Rota atualizada pela TomTom com trânsito quando disponível.',
      });
    }

    let googleResult = null;
    if (googleKey) googleResult = await googleRoutePreview(origin, destination, requestedMode, googleKey);
    if (googleResult?.ok) return sendJson(res, 200, {
      ...googleResult,
      providerOrder: requestedMode === 'transit' ? ['Google Routes'] : ['TomTom', 'Google Routes'],
      fallback: requestedMode !== 'transit' && Boolean(tomtomKey),
      fallbackFrom: requestedMode !== 'transit' && tomtomKey ? 'TomTom' : undefined,
      fallbackReason: requestedMode !== 'transit' && tomtomKey ? 'tomtom_unavailable' : undefined,
      learningEligible: requestedMode !== 'transit',
    });

    return sendJson(res, 200, {
      ok: false,
      configured: true,
      providerOrder: requestedMode === 'transit' ? ['Google Routes'] : ['TomTom', 'Google Routes'],
      mapsBudget: googleResult?.mapsBudget || await googleMapsBudgetStatus(),
      message: requestedMode === 'transit' && googleResult?.budgetDenied
        ? 'Limite mensal do Google Maps atingido. Transporte público ficará disponível no próximo ciclo; abra o Google Maps para navegação externa.'
        : 'Rota ao vivo indisponível agora. Use Abrir no Google Maps.',
    });
  } catch {
    return sendJson(res, 200, { ok: false, configured: true, mapsBudget: await googleMapsBudgetStatus(), message: 'Rota ao vivo indisponível agora. Use Abrir no Google Maps.' });
  }
}
function sanitizedMapsProbe(provider, configured, result) {
  if (!configured) return { provider, configured: false, state: 'not_configured' };
  if (!result) return { provider, configured: true, state: 'unavailable' };
  const distanceMeters = Number(result.distanceMeters);
  const durationSeconds = Number(result.durationSeconds);
  const routeValid = result.ok === true
    && Number.isFinite(distanceMeters) && distanceMeters > 0
    && Number.isFinite(durationSeconds) && durationSeconds > 0;
  return {
    provider,
    configured: true,
    state: routeValid
      ? 'available'
      : result.failureClass === 'quota' || result.quotaFailure || result.budgetDenied
        ? 'quota'
        : result.failureClass || 'unavailable',
    httpStatus: Number(result.httpStatus) || undefined,
    routeValid,
    liveTraffic: routeValid ? Boolean(result.liveTraffic || result.trafficAware) : false,
    updatedAt: routeValid ? result.updatedAt || new Date().toISOString() : undefined,
  };
}
async function handleMapsProviderStatus(req, res) {
  const identity = alarmRequestIdentity(req);
  if (!identity.admin) return sendJson(res, 403, { ok: false, message: 'Controle mensal de mapas disponível somente no Admin.' });
  const budget = await googleMapsBudgetStatus();
  const googleKey = mapsServerKey();
  const tomtomKey = tomtomServerKey();
  const googleConfigured = Boolean(googleKey);
  const tomtomConfigured = Boolean(tomtomKey);
  const status = {
    ok: googleConfigured || tomtomConfigured,
    primary: tomtomConfigured ? 'TomTom' : googleConfigured && !budget.blocked ? 'Google Routes' : 'Indisponível',
    fallback: tomtomConfigured && googleConfigured && !budget.blocked ? 'Google Routes' : null,
    googleConfigured,
    tomtomConfigured,
    budget,
    probeAvailable: true,
    message: tomtomConfigured
      ? 'TomTom é o provedor principal para carro; Google Routes permanece como contingência e transporte público.'
      : budget.blocked
        ? 'Google Maps pausado até a próxima competência; rota terrestre indisponível sem TomTom.'
        : `Google Routes ativo como contingência: ${budget.used} de ${budget.limit} solicitações usadas neste mês.`,
  };

  const requestUrl = new URL(req.url || '/api/maps/provider/status', 'https://crewcheck.local');
  if (requestUrl.searchParams.get('probe') !== '1') return sendJson(res, 200, status);

  const origin = 'Aeroporto Internacional de Brasília, Brasília - DF';
  const destination = 'ParkShopping Brasília, Brasília - DF';
  let tomtomResult = null;
  let googleResult = null;
  try {
    if (tomtomKey) tomtomResult = await tomtomRoutePreview(origin, destination, tomtomKey);
  } catch {}
  try {
    if (googleKey && !budget.blocked) googleResult = await googleRoutePreview(origin, destination, 'driving', googleKey);
  } catch {}

  const providers = [
    sanitizedMapsProbe('TomTom', tomtomConfigured, tomtomResult),
    sanitizedMapsProbe('Google Routes', googleConfigured, googleResult),
  ];
  return sendJson(res, 200, {
    ...status,
    ok: providers.some((item) => item.state === 'available'),
    runtimeProbe: {
      executed: true,
      scope: 'rota terrestre curta em Brasília',
      providers,
      checkedAt: new Date().toISOString(),
      note: 'O probe é executado somente sob solicitação explícita do Admin e não expõe chaves nem payload bruto dos provedores.',
    },
  });
}
