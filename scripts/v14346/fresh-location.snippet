const CURRENT_GEO_META_KEY = 'crewcheck_last_geo_meta';
const CURRENT_GEO_MAX_AGE_MS = 30 * 60_000;

type CrewFreshGeoPosition = {
  lat: number;
  lng: number;
  accuracy?: number;
  capturedAt: string;
  source: 'android-native' | 'browser' | 'browser-watch';
};

function crewLocationBridge(): any {
  if (typeof window === 'undefined') return null;
  return (window as any).CrewCheckNative || (window as any).AndroidCrewCheckNative || null;
}

function currentGeoSupported(): boolean {
  return Boolean((typeof navigator !== 'undefined' && navigator.geolocation) || crewLocationBridge()?.requestCurrentLocation);
}

function validCurrentGeo(lat: unknown, lng: unknown): { lat: number; lng: number } | null {
  const latitude = Number(lat);
  const longitude = Number(lng);
  if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) return null;
  if (latitude < -90 || latitude > 90 || longitude < -180 || longitude > 180) return null;
  return { lat: latitude, lng: longitude };
}

function persistCurrentGeoPosition(position: Omit<CrewFreshGeoPosition, 'capturedAt'> & { capturedAt?: string }): CrewFreshGeoPosition {
  const point = validCurrentGeo(position.lat, position.lng);
  if (!point) throw new Error('As coordenadas recebidas são inválidas.');
  const capturedAt = position.capturedAt || new Date().toISOString();
  const saved: CrewFreshGeoPosition = {
    ...point,
    accuracy: Number.isFinite(Number(position.accuracy)) ? Number(position.accuracy) : undefined,
    capturedAt,
    source: position.source,
  };
  storage.set('crewcheck_last_geo', coordsLabel(saved.lat, saved.lng));
  storage.set(CURRENT_GEO_META_KEY, JSON.stringify(saved));
  return saved;
}

function loadFreshCurrentGeo(maxAgeMs = CURRENT_GEO_MAX_AGE_MS): { lat: number; lng: number; accuracy?: number } | null {
  const pair = coordinatePair(storage.get('crewcheck_last_geo', ''));
  let meta: Partial<CrewFreshGeoPosition> | null = null;
  try { meta = JSON.parse(storage.get(CURRENT_GEO_META_KEY, 'null')); } catch { meta = null; }
  const capturedAt = Date.parse(String(meta?.capturedAt || ''));
  const samePoint = pair && validCurrentGeo(meta?.lat, meta?.lng)
    && Math.abs(pair.lat - Number(meta?.lat)) < 0.000001
    && Math.abs(pair.lng - Number(meta?.lng)) < 0.000001;
  const fresh = Number.isFinite(capturedAt) && Date.now() - capturedAt >= 0 && Date.now() - capturedAt <= maxAgeMs;
  if (!pair || !samePoint || !fresh) {
    storage.set('crewcheck_last_geo', '');
    storage.set(CURRENT_GEO_META_KEY, '');
    return null;
  }
  return { ...pair, accuracy: Number.isFinite(Number(meta?.accuracy)) ? Number(meta?.accuracy) : undefined };
}

function requestNativeCurrentGeoPosition(): Promise<{ lat: number; lng: number; accuracy?: number }> {
  return new Promise((resolve, reject) => {
    const native = crewLocationBridge();
    if (!native?.requestCurrentLocation) {
      reject(new Error('Localização nativa indisponível.'));
      return;
    }
    const callbackId = `location_${Date.now()}_${Math.random().toString(36).slice(2)}`;
    const cleanup = () => {
      window.clearTimeout(timer);
      window.removeEventListener('crewcheck:native-location-result', onResult as EventListener);
    };
    const onResult = (incoming: Event) => {
      const detail = (incoming as CustomEvent).detail || {};
      if (String(detail.callbackId || '') !== callbackId) return;
      cleanup();
      const point = validCurrentGeo(detail.lat, detail.lng);
      if (!detail.ok || !point) {
        reject(new Error(String(detail.error || 'O Android não retornou uma posição válida.')));
        return;
      }
      resolve({ ...point, accuracy: Number.isFinite(Number(detail.accuracy)) ? Number(detail.accuracy) : undefined });
    };
    const timer = window.setTimeout(() => {
      cleanup();
      reject(new Error('O GPS nativo demorou para responder.'));
    }, 16_000);
    window.addEventListener('crewcheck:native-location-result', onResult as EventListener);
    try {
      const accepted = native.requestCurrentLocation(callbackId);
      if (accepted === false) {
        cleanup();
        reject(new Error('O Android não aceitou a solicitação de localização.'));
      }
    } catch (error) {
      cleanup();
      reject(error instanceof Error ? error : new Error('Falha ao solicitar o GPS nativo.'));
    }
  });
}

function requestBrowserCurrentGeoPosition(): Promise<{ lat: number; lng: number; accuracy?: number }> {
  return new Promise((resolve, reject) => {
    if (!navigator.geolocation) {
      reject(new Error('Permissão de localização indisponível neste dispositivo.'));
      return;
    }
    navigator.geolocation.getCurrentPosition(
      (position) => {
        const point = validCurrentGeo(position.coords.latitude, position.coords.longitude);
        if (!point) {
          reject(new Error('O navegador retornou coordenadas inválidas.'));
          return;
        }
        resolve({
          ...point,
          accuracy: Number.isFinite(Number(position.coords.accuracy)) ? Number(position.coords.accuracy) : undefined,
        });
      },
      (error) => reject(new Error(error?.code === 1
        ? 'Localização bloqueada. Permita o acesso nos ajustes do site e tente novamente.'
        : 'Não consegui obter uma posição nova agora. Ative o GPS em alta precisão e tente novamente.')),
      { enableHighAccuracy: true, timeout: 20_000, maximumAge: 0 },
    );
  });
}

async function getCurrentGeoPosition(): Promise<{ lat: number; lng: number; accuracy?: number }> {
  if (!currentGeoSupported()) throw new Error('Localização não disponível neste aparelho.');
  let position: { lat: number; lng: number; accuracy?: number } | null = null;
  let source: CrewFreshGeoPosition['source'] = 'browser';
  if (crewLocationBridge()?.requestCurrentLocation) {
    try {
      position = await requestNativeCurrentGeoPosition();
      source = 'android-native';
    } catch {
      position = null;
    }
  }
  if (!position) {
    position = await requestBrowserCurrentGeoPosition();
    source = 'browser';
  }
  const saved = persistCurrentGeoPosition({ ...position, source });
  return { lat: saved.lat, lng: saved.lng, accuracy: saved.accuracy };
}
