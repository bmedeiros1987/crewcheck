async function conciergeHotelsReply(snapshot) {
  const roster = snapshot?.roster || {};
  const assigned = (roster.days || []).filter((day) => day?.hotel).slice(0, 6);
  if (assigned.length) return ['Hotéis publicados/detectados na escala:', ...assigned.map((day) => `• ${day.hotel} · ${day.date || ''}`)].join('\n');
  const locationState = conciergeLocationContextV14335(snapshot);
  const stay = conciergeCurrentStay(roster);
  const next = conciergeNextProgram(roster);
  const airport = stay?.location || next?.legs?.[0]?.origin || roster.base || '';
  const contextText = stay?.hotel || (airport ? `${airport} ${WEATHER_AIRPORT_POINTS[airport]?.city || ''}` : '');
  if (!locationState.fresh && !contextText) return locationState.message;
  const places = await conciergeSearchPlaces('hotel para tripulação próximo ao aeroporto', locationState.fresh ? '' : contextText, locationState.fresh ? locationState.location : null, 4);
  if (!places.length) return `Nenhum hotel foi publicado na escala e não encontrei sugestões agora. ${locationState.fresh ? conciergeLocationLineV14335(snapshot) : locationState.message}`;
  return [
    'A escala não informa hotel. Estas são sugestões — não são reserva da companhia:',
    locationState.fresh ? conciergeLocationLineV14335(snapshot) : `Contexto usado: ${contextText}. Nenhuma localização pessoal recente foi aplicada.`,
    '',
    conciergePlaceLines(places),
  ].join('\n');
}

async function conciergeGymsReply(snapshot) {
  const locationState = conciergeLocationContextV14335(snapshot);
  const stay = conciergeCurrentStay(snapshot?.roster);
  if (!locationState.fresh && !stay?.hotel) return locationState.message;
  const plan = String(snapshot?.preferences?.gymPlan || 'ambos');
  const partnerChains = 'Selfit Panobianco Bluefit Corpo e Saúde Pratique Fórmula Bodytech Fábrica de Monstros Ultra';
  const query = plan === 'smartfit' ? 'Smart Fit academia aberta agora' : plan === 'wellhub' ? `${partnerChains} academia parceira aberta agora` : `Smart Fit ${partnerChains} academia aberta agora`;
  const places = await conciergeSearchPlaces(query, locationState.fresh ? '' : stay.hotel, locationState.fresh ? locationState.location : null, 5);
  if (!places.length) return `Não encontrei academias agora. ${locationState.fresh ? conciergeLocationLineV14335(snapshot) : `Contexto do pernoite: ${stay.hotel}. Compartilhe a localização para busca precisa.`}`;
  return [
    `Academias próximas · busca ${plan === 'ambos' ? 'Wellhub + Smart Fit' : plan}:`,
    locationState.fresh ? conciergeLocationLineV14335(snapshot) : `Contexto usado: hotel ${stay.hotel}. Compartilhe a localização para distância real.`,
    '',
    conciergePlaceLines(places),
    '',
    'Wellhub é um benefício corporativo, não uma academia. Confirme parceria, elegibilidade, lotação e horário nos canais oficiais antes de sair.',
  ].join('\n');
}

async function conciergeHospitalsReply(snapshot) {
  const locationState = conciergeLocationContextV14335(snapshot);
  if (!locationState.fresh) return `${locationState.message}\nEm emergência, use imediatamente os canais oficiais da sua região; o CrewCheck não substitui atendimento médico.`;
  const places = await conciergeSearchPlaces('hospital pronto atendimento emergência 24 horas', '', locationState.location, 5);
  if (!places.length) return `Não encontrei hospitais pelo serviço de locais agora. ${conciergeLocationLineV14335(snapshot)} Em emergência, use os canais oficiais da sua região.`;
  return [
    'Hospitais e prontos atendimentos próximos',
    conciergeLocationLineV14335(snapshot),
    '',
    conciergePlaceLines(places),
    '',
    'Resultados limitados a até 35 km da localização recente. Confirme rota, atendimento e disponibilidade. Em emergência, procure o serviço oficial imediatamente.',
  ].join('\n');
}

async function conciergePharmaciesReply(snapshot) {
  const locationState = conciergeLocationContextV14335(snapshot);
  if (!locationState.fresh) return locationState.message;
  const places = await conciergeSearchPlaces('farmácia aberta agora', '', locationState.location, 6);
  if (!places.length) return `Não encontrei farmácias próximas agora. ${conciergeLocationLineV14335(snapshot)} Tente novamente ou abra o mapa do aparelho.`;
  return [
    'Farmácias próximas',
    conciergeLocationLineV14335(snapshot),
    '',
    conciergePlaceLines(places),
    '',
    'A busca usa somente a localização recente enviada no Telegram e descarta resultados a mais de 35 km.',
  ].join('\n');
}
