async function sendHumanTelegramVoiceReply(chatId, replyText, transcript = '', snapshot = null) {
  const policy = premiumVoicePolicy(replyText, transcript, Math.max(420, Math.min(700, Number(envAny(['TELEGRAM_CONCIERGE_MAX_VOICE_CHARS', 'CREWCHECK_TELEGRAM_MAX_VOICE_CHARS']) || 650))));
  if (!policy.allowed) return false;
  const finalReply = premiumVoiceText(replyText);
  const voiceProfile = conciergeVoiceProfileForSnapshotV14348(snapshot);
  await showHumanRecordingAction(chatId, 1);
  const audioReply = await sendTelegramTtsAudio(chatId, finalReply, {
    caption: telegramHumanAudioCaption(),
    filename: 'crewcheck-voice.ogg',
    voiceProfile,
  });
  if (audioReply?.ok) {
    if (telegramShouldEchoTranscript() && transcript) {
      await sendTelegramMessage(chatId, `Entendi: “${String(transcript).slice(0, 500)}”`);
    }
    return true;
  }
  return false;
}
