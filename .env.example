# CrewCheck production environment template
# Copy variable names to Render. Never commit real values.
NODE_ENV=production
PORT=4173

# Public application
CREWCHECK_PUBLIC_URL=https://crewcheck.online
PUBLIC_APP_URL=https://crewcheck.online
PUBLIC_URL=https://crewcheck.online
APP_URL=https://crewcheck.online
CREWCHECK_DEFAULT_TIMEZONE=America/Sao_Paulo
CREWCHECK_DEFAULT_LOCALE=pt-BR

# Aiven MySQL (server-side only)
# Use the Aiven Service URI. Keep credentials only in Render.
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED
# Optional aliases supported by CrewCheck.
CREWCHECK_DATABASE_URL=
MYSQL_URL=
MYSQL_SSL_MODE=REQUIRED
CREWCHECK_DATABASE_PROVIDER=aiven-mysql
# Keep false in production. Apply the SQL migration explicitly before deploy.
CREWCHECK_DB_AUTO_MIGRATE=false

# Terms and privacy audit (optional salt; generate a random server-only value)
CREWCHECK_TERMS_AUDIT_SALT=

# Amil credentialed network. Keep disabled until Amil provides credentials and
# the official provider-search path for your contract.
CREWCHECK_AMIL_ENABLED=false
AMIL_API_BASE_URL=https://api-dev.servicos.grupoamil.com.br
AMIL_API_SEARCH_PATH=
AMIL_API_ACCESS_TOKEN=
AMIL_API_KEY=

# Authentication and encryption
CREWCHECK_AUTH_REQUIRED=true
CREWCHECK_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CREWCHECK_DATA_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_32_BYTE_SECRET
CREWCHECK_ADMIN_EMAILS=admin@example.com
CREWCHECK_ADMIN_EMAIL=
CREWCHECK_BLOCKED_EMAIL_DOMAINS=example-airline.com
CREWCHECK_TEST_ACCOUNT_ENABLED=false
CREWCHECK_TEST_ACCOUNT_EMAIL=
CREWCHECK_TEST_ACCOUNT_PASSWORD=
CREWCHECK_PREMIUM_UNLIMITED_EMAILS=
CREWCHECK_TRUST_LEGACY_PREMIUM_PROFILE=false

# Plans and usage limits
CREWCHECK_PREMIUM_MONTHLY_BRL=19.90
CREWCHECK_PREMIUM_ANNUAL_BRL=179.90
CREWCHECK_FREE_CALL_LIMIT=1
CREWCHECK_PREMIUM_CALL_LIMIT=20
CREWCHECK_UNLIMITED_CALL_LIMIT=60

# Asaas web subscriptions
ASAAS_ENV=production
ASAAS_API_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Google Play Billing / RTDN
GOOGLE_PLAY_PACKAGE_NAME=com.crewcheck.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_MONTHLY_PRODUCT_ID=crewcheck_premium_monthly
GOOGLE_PLAY_ANNUAL_PRODUCT_ID=crewcheck_premium_annual

# Transactional email API (server-side)
MAILERSEND_API_KEY=
MAILERSEND_FROM=contato@crewcheck.online
MAILERSEND_FROM_NAME=CrewCheck

# Telegram Concierge and webhook
TELEGRAM_BOT_TOKEN=
CREWCHECK_TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=crewchecknotify_bot
TELEGRAM_PUBLIC_BASE_URL=https://crewcheck.online
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_CONCIERGE_HUMAN_VOICE_ENABLED=true
TELEGRAM_CONCIERGE_ECHO_TRANSCRIPT=false
TELEGRAM_CONCIERGE_AUDIO_SEND_MODE=voice
TELEGRAM_CONCIERGE_SPEECH_PROVIDER=elevenlabs
TELEGRAM_CONCIERGE_STT_PROVIDER=elevenlabs

# ElevenLabs STT/TTS. Legacy ELEVENLABS_TTS_* aliases remain supported.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TTS_STABILITY=0.48
ELEVENLABS_TTS_SIMILARITY_BOOST=0.78
ELEVENLABS_TTS_STYLE=0.18
ELEVENLABS_TTS_SPEAKER_BOOST=true
ELEVENLABS_STT_MODEL=scribe_v2
CREWCHECK_STT_PROVIDER=elevenlabs
CREWCHECK_TTS_PROVIDER=elevenlabs
CREWCHECK_FORCE_ELEVENLABS_TTS=true
CREWCHECK_ALLOW_OPENAI_STT_FALLBACK=false
CREWCHECK_ALLOW_GOOGLE_TTS_FALLBACK=false

# Optional OpenAI features. Not required for Telegram audio when ElevenLabs is active.
OPENAI_API_KEY=
OPENAI_MODEL=

# Calls / wake-up providers
CALLMEBOT_TELEGRAM_CALL_USER=
CALLMEBOT_API_KEY=
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_FROM=
INFOBIP_PHONE_FROM=
CREWCHECK_INFOBIP_USE_ELEVENLABS_AUDIO=true
CREWCHECK_INFOBIP_USE_GOOGLE_TTS_AUDIO=false

# Radar and operational flight data
FLIGHTAWARE_API_KEY=
AVIATIONSTACK_API_KEY=
AERODATABOX_API_KEY=
CREWCHECK_RADAR_PROVIDER=flightaware
CREWCHECK_RADAR_CACHE_SECONDS=300
CREWCHECK_FLIGHT_FOLLOW_LEAD_MINUTES=120

# Official aviation weather and schedule-aware critical Telegram alerts
# Keep REDEMET_API_KEY server-side. Never prefix it with VITE_.
REDEMET_API_KEY=
CREWCHECK_SCHEDULER_SECRET=
CREWCHECK_WEATHER_MONITOR_ENABLED=false
CREWCHECK_WEATHER_MONITOR_INTERVAL_MINUTES=10

# Maps, routes, geocoding and transport estimates
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
TOMTOM_API_KEY=
OPENROUTESERVICE_API_KEY=
MAPBOX_ACCESS_TOKEN=
CREWCHECK_GEOCODING_PROVIDER=google
CREWCHECK_ROUTING_PROVIDER=tomtom
CREWCHECK_UBER_DEEPLINK_ENABLED=true

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crewcheck.online/api/google/callback

# Runtime update center
CREWCHECK_UPDATE_ADMIN_TOKEN=
CREWCHECK_RUNTIME_PATCH_ENABLED=true

# Privacy and diagnostics
CREWCHECK_LOG_LEVEL=info
CREWCHECK_LOG_SENSITIVE_DATA=false
CREWCHECK_RELIABILITY_DIAGNOSTICS=true

