# CrewCheck Premium · MySQL/Aiven
# Nunca commite credenciais reais.

NODE_VERSION=22.13.0
NODE_ENV=production

DATABASE_URL=mysql://avnadmin:SUA_SENHA@mysql-1c3b1be8-vitoriaregia1.a.aivencloud.com:22966/defaultdb?ssl-mode=REQUIRED
MYSQL_SSL_MODE=REQUIRED
CREWCHECK_AUTO_MIGRATE=true
CREWCHECK_AUTH_REQUIRED=true
CREWCHECK_SESSION_DAYS=30

APP_URL=https://crewcheck.onrender.com
EMAIL_FROM_NAME=CrewCheck

MAILERSEND_API_KEY=
MAILERSEND_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM=

# Google Calendar Sync (OAuth Web Client ID)
# Criar no Google Cloud Console, tipo "Web application", com origem autorizada do domínio do CrewCheck.
VITE_GOOGLE_CLIENT_ID=

# Flight Status Providers (opcionais; backend only, nunca expor no front)
# Fonte 1: BSB Aero público continua ativa sem chave quando a rota envolve BSB.
BSB_AERO_CACHE_TTL_MS=90000

# Fonte 2: Aviationstack. Configure para status/portão/terminal por /flights e /timetable.
AVIATIONSTACK_ACCESS_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
AVIATIONSTACK_CACHE_TTL_MS=120000

# Fonte 3: Amadeus On-Demand Flight Status. Use test.api por padrão; troque para produção quando contratado.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_API_BASE=https://test.api.amadeus.com
AMADEUS_CACHE_TTL_MS=120000

# Fonte 4: proxy próprio opcional, usado por último.
FLIGHT_STATUS_ENDPOINT=

# CrewCheck v10.8.38 — Radar Push Hub privado
# Todos os provedores abaixo são backend only. O usuário vê apenas “Radar CrewCheck”.
# Cirium/FlightStats — recomendado para portão, terminal e status por voo/aeroporto.
FLIGHTSTATS_APP_ID=
FLIGHTSTATS_APP_KEY=
CIRIUM_APP_ID=
CIRIUM_APP_KEY=
FLIGHTSTATS_CACHE_TTL_MS=300000

# AeroDataBox — alternativa/segunda fonte para FIDS, status, portão e terminal.
AERODATABOX_API_KEY=
AERODATABOX_BASE_URL=https://prod.api.market/api/v1/aedbx/aerodatabox
AERODATABOX_RAPIDAPI_KEY=
AERODATABOX_RAPIDAPI_HOST=aerodatabox.p.rapidapi.com
AERODATABOX_CACHE_TTL_MS=120000
AERODATABOX_BOARD_CACHE_TTL_MS=300000

# FlightAware AeroAPI — alternativa premium para status individual.
FLIGHTAWARE_AEROAPI_KEY=
FLIGHTAWARE_AEROAPI_BASE_URL=https://aeroapi.flightaware.com/aeroapi
FLIGHTAWARE_CACHE_TTL_MS=120000

# Amadeus On-Demand Flight Status — alternativa oficial para horário, atraso, terminal/portão quando disponível.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_API_BASE=https://test.api.amadeus.com
AMADEUS_CACHE_TTL_MS=120000

# Proxy próprio opcional para qualquer fonte privada contratada.
# Útil para integrar Kayak/Google Flights/FlightStats via fornecedor autorizado sem expor link ao usuário.
FLIGHT_STATUS_ENDPOINT=

# CrewCheck v10.8.47 — Saída Inteligente Reliable
# Ative a Routes API no Google Maps Platform. A chave fica só no backend/Render.
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
CREWCHECK_COMMUTE_CACHE_TTL_MS=120000
CREWCHECK_LOCAL_TIMEZONE=America/Sao_Paulo

# CrewCheck v10.8.50 — Saída Inteligente Premium
# Use estas variáveis no Render para manter a chave fora do app/frontend.
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_GEOCODING_API_KEY=
CREWCHECK_COMMUTE_CACHE_TTL_MS=60000
CREWCHECK_LOCAL_TIMEZONE=America/Sao_Paulo
CREWCHECK_COMMUTE_TRANSIT_ENABLED=true
CREWCHECK_SMART_DEPARTURE_ENABLED=true

# Saída Inteligente Super Premium — Google Routes + Uber/99
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_GEOCODING_API_KEY=
CREWCHECK_COMMUTE_ENABLE_RIDES=true
CREWCHECK_COMMUTE_COMPARE_MODES=DRIVE,TRANSIT,RIDE_APP
CREWCHECK_COMMUTE_FASTEST_MODE=AUTO
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_ENV=testing
UBER_ESTIMATES_ENABLED=true
UBER_RIDE_DEEPLINK_ENABLED=true
APP99_ENABLED=false
APP99_DEEPLINK_ENABLED=true

# CrewCheck v10.8.54 — Uber Force Reliable
# Tenta múltiplos caminhos oficiais: Uber Guest Trip Estimates, Price Estimates legado quando disponível, e fallback auditável + deep link.
UBER_GUEST_ESTIMATES_ENABLED=true
UBER_FORCE_MULTI_ENDPOINTS=true
# Se sua conta Uber for Business exigir organização/sandbox, preencha:
UBER_ORGANIZATION_UUID=
UBER_SANDBOX_RUN_UUID=

# CrewCheck Billing / Asaas (não commite chaves reais)
# Homologação: ASAAS_ENV=homologation e ASAAS_API_BASE=https://api-sandbox.asaas.com/v3
# Produção: ASAAS_ENV=production e ASAAS_API_BASE=https://api.asaas.com/v3
ASAAS_ENV=production
ASAAS_API_BASE=https://api.asaas.com/v3
ASAAS_API_KEY=
# Token de autenticação do Webhook Asaas. Configure o mesmo valor na tela do webhook Asaas.
# O Asaas envia este valor no header oficial: asaas-access-token.
ASAAS_WEBHOOK_TOKEN=
# Opcional: use tokens separados para homologação/produção ou transição sem quebrar eventos antigos.
ASAAS_WEBHOOK_TOKEN_SANDBOX=
ASAAS_WEBHOOK_TOKEN_PRODUCTION=
ASAAS_WEBHOOK_TOKEN_PREVIOUS=
# Em produção, mantenha true para exigir token. Em sandbox, pode deixar false para testar enquanto ajusta o webhook.
ASAAS_WEBHOOK_STRICT=true
ASAAS_WEBHOOK_ALLOW_SANDBOX_WITHOUT_TOKEN=false
CREWCHECK_TRIAL_DAYS=7
# Plano Premium reajustado para cobrir servidor, FlightAware/radar, Vivo de Extra e e-mail interno.
CREWCHECK_DIARIA_REFERENCE_VALUE=136.80
CREWCHECK_PREMIUM_ANNUAL_DISCOUNT_PERCENT=15
CREWCHECK_BILLING_MONTHLY_VALUE=19.90
CREWCHECK_BILLING_YEARLY_VALUE=199.90
CREWCHECK_LIFETIME_EMAILS=admin@crewcheck.local,assinante@exemplo.com
ASAAS_TIMEOUT_MS=15000

# Conta de teste gratuita criada automaticamente no login, sem Premium e sem cobrança.
CREWCHECK_TEST_ACCOUNT_ENABLED=true
CREWCHECK_TEST_ACCOUNT_EMAIL=teste@crewcheck.app
CREWCHECK_TEST_ACCOUNT_PASSWORD=CrewCheck@2026

# CrewCheck v10.8.116 — Validação de e-mail e anti-robôs
# Recomendo Cloudflare Turnstile: crie o widget no Cloudflare e configure site key/secret no Render.
PUBLIC_APP_URL=https://crewcheck.online
CREWCHECK_EMAIL_VERIFICATION_REQUIRED=true
CREWCHECK_EMAIL_VERIFICATION_TTL_MINUTES=30
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CREWCHECK_CAPTCHA_REQUIRED=true
CREWCHECK_REGISTER_RATE_LIMIT_MAX=10
CREWCHECK_REGISTER_RATE_LIMIT_WINDOW_MS=3600000


# Vivo de Extra — Google Flights oficial por APIs privadas backend-only.
# Ordem padrão: SerpAPI primeiro (voltou ao padrão que funcionava melhor), SearchAPI.io como fallback, Amadeus como terceiro fallback.
EXTRA_FLIGHT_PROVIDER_ORDER=SERPAPI,SEARCHAPI,AMADEUS

# SerpAPI / Google Flights — fonte principal. Nunca commite chave real.
SERPAPI_API_KEY=
SERPAPI_API_BASE=https://serpapi.com/search.json
SERPAPI_EXTRA_ENABLED=true
SERPAPI_EXTRA_INCLUDED_AIRLINES=LA,G3,AD
SERPAPI_EXTRA_CACHE_TTL_MS=600000
SERPAPI_TIMEOUT_MS=18000
SERPAPI_DEEP_SEARCH=false
EXTRA_FLIGHT_REAL_CONNECTIONS_ENABLED=true
EXTRA_FLIGHT_CONNECTION_HUBS=GRU,CGH,VCP,CNF,SDU,GIG,SSA,REC,FOR,POA
EXTRA_FLIGHT_MIN_CONNECTION_MINUTES=55
EXTRA_FLIGHT_MAX_CONNECTION_MINUTES=300
EXTRA_FLIGHT_CONNECTION_MAX_OPTIONS=6

# SearchAPI.io / Google Flights — fallback com companhia, número de voo, tarifa e conexões cabíveis.
SEARCHAPI_API_KEY=
SEARCHAPI_API_BASE=https://www.searchapi.io/api/v1/search
SEARCHAPI_EXTRA_ENABLED=true
SEARCHAPI_EXTRA_INCLUDED_AIRLINES=LA,G3,AD
SEARCHAPI_EXTRA_ENRICH_RADAR=true
SEARCHAPI_EXTRA_CACHE_TTL_MS=600000
SEARCHAPI_TIMEOUT_MS=18000

# CrewCheck v10.8.121 — Maps backend-only
# Cole a chave enviada no Render, nunca no frontend/GitHub.
# Use a mesma chave, de preferência restrita por API e domínio/IP.
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=
CREWCHECK_MAPS_PROVIDER=google-routes
CREWCHECK_COMMUTE_TRANSIT_ENABLED=true
CREWCHECK_COMMUTE_COMPARE_MODES=DRIVE,TRANSIT,RIDE_APP

# CrewCheck v10.8.121 — cache compartilhado do Vivo de Extra
EXTRA_FLIGHT_DB_CACHE_ENABLED=true
EXTRA_FLIGHT_DB_CACHE_TTL_MS=21600000

# CrewCheck v10.8.124 — Radar API-first
AIRPORT_BOARD_API_FIRST=true
AIRPORT_BOARD_STORE_EMPTY_CACHE=false
AIRPORT_BOARD_API_PROVIDER_ORDER=FLIGHTSTATS,AERODATABOX,AVIATIONSTACK,OFFICIAL
AIRPORT_BOARD_DB_CACHE_ENABLED=true
AIRPORT_BOARD_DB_CACHE_TTL_MS=10800000
AIRPORT_BOARD_CACHE_CURRENT_DAY_ONLY=true


# Radar API-first v10.8.126 — FlightAware principal
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_API_BASE=https://aeroapi.flightaware.com/aeroapi
FLIGHTAWARE_TIMEOUT_MS=15000
FLIGHTAWARE_BOARD_CACHE_TTL_MS=600000
AIRPORT_BOARD_API_PROVIDER_ORDER=FLIGHTAWARE,FLIGHTSTATS,AERODATABOX,AVIATIONSTACK,OFFICIAL
AIRPORT_BOARD_API_FIRST=true
AIRPORT_BOARD_STORE_EMPTY_CACHE=false
AIRPORT_BOARD_DB_CACHE_ENABLED=true
AIRPORT_BOARD_DB_CACHE_TTL_MS=10800000
AVIATIONSTACK_MONTHLY_LIMIT_COOLDOWN_MS=21600000

# CrewCheck v10.8.127 - Sabre sessionless auth (não coloque credenciais no GitHub)
SABRE_ENABLED=true
SABRE_ENV=test
SABRE_AUTH_VERSION=v2
SABRE_TOKEN_URL=https://api-crt.cert.havail.sabre.com/v3/auth/token
SABRE_REST_BASE=https://api-crt.cert.havail.sabre.com
SABRE_USERNAME=cole_o_usuario_sabre_no_render
SABRE_PASSWORD=cole_a_senha_sabre_no_render
# Se sua conta usar OAuth v3 completo, configure também:
# SABRE_CLIENT_ID=seu_client_id
# SABRE_CLIENT_SECRET=seu_client_secret
SABRE_TIMEOUT_MS=15000

# Radar API-first com FlightAware como fonte principal
FLIGHTAWARE_API_KEY=sua_chave_flightaware
AIRPORT_BOARD_API_PROVIDER_ORDER=FLIGHTAWARE,FLIGHTSTATS,AERODATABOX,AVIATIONSTACK,OFFICIAL
AIRPORT_BOARD_API_FIRST=true
AIRPORT_BOARD_STORE_EMPTY_CACHE=false
AIRPORT_BOARD_DB_CACHE_ENABLED=true


# CrewCheck v10.8.129 — compartilhamento por e-mail interno
EMAIL_FROM=contato@crewcheck.online
EMAIL_FROM_NAME=CrewCheck
# Configure pelo menos um provedor:
# SENDGRID_API_KEY=...
# MAILERSEND_API_KEY=...
CREWCHECK_EMAIL_ATTACHMENT_MAX_BASE64=7000000

# CrewCheck v10.8.129 — Radar por GPS do usuário, auth e logos reais
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_API_BASE=https://aeroapi.flightaware.com/aeroapi
AIRPORT_BOARD_API_PROVIDER_ORDER=FLIGHTAWARE,FLIGHTSTATS,AERODATABOX,AVIATIONSTACK,OFFICIAL
AIRPORT_BOARD_API_FIRST=true
AIRPORT_BOARD_STORE_EMPTY_CACHE=false
AIRPORT_BOARD_DB_CACHE_ENABLED=true

# CrewCheck v10.8.130 — suporte interno, Google Play e preço recomendado
CREWCHECK_BILLING_MONTHLY_VALUE=19.90
CREWCHECK_BILLING_YEARLY_VALUE=179.90
SUPPORT_DESTINATION_EMAIL=seu_email_de_suporte_privado
CREWCHECK_SUPPORT_EMAIL=seu_email_de_suporte_privado
PUBLIC_APP_URL=https://crewcheck.online


# CrewCheck lançamento comercial
CREWCHECK_LAUNCH_PROMO_ENABLED=true
CREWCHECK_LAUNCH_PROMO_END_DATE=2026-07-19
CREWCHECK_BILLING_MONTHLY_ORIGINAL_VALUE=19.90
CREWCHECK_BILLING_YEARLY_ORIGINAL_VALUE=179.90
CREWCHECK_BILLING_MONTHLY_PROMO_VALUE=9.95
CREWCHECK_BILLING_YEARLY_PROMO_VALUE=89.95
CREWCHECK_PREMIUM_ANNUAL_DISCOUNT_PERCENT=50
SUPPORT_WHATSAPP_URL=https://wa.me/5500000000000
AIRPORT_BOARD_WITH_CARGO=true

VITE_CREWCHECK_ADMIN_EMAIL=admin@crewcheck.local

# CrewCheck v10.8.132 — SMTP fallback para e-mails internos
# Use quando SendGrid/MailerSend API falhar ou não estiver configurado.
# Não coloque senhas reais no GitHub; configure somente no Render.
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=cole_o_usuario_smtp_no_render
SMTP_PASSWORD=cole_a_senha_smtp_no_render
SMTP_FROM=contato@crewcheck.online
SMTP_TIMEOUT_MS=20000
