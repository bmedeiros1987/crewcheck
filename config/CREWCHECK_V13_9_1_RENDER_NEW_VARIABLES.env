# CrewCheck v13.9.1 — somente variáveis novas verificadas no código
# Não coloque valores secretos no GitHub. Preencha no painel do Render.

# CrewLock
CREWCHECK_CREWLOCK_DB_FALLBACK=true
CREWCHECK_CREWLOCK_DB_FALLBACK_MAX_MB=10

# Central de Emergência
CREWCHECK_EMERGENCY_ENABLED=true
CREWCHECK_EMERGENCY_RATE_LIMIT_SECONDS=60

# Segredo diferente do CREWCHECK_AUTH_SECRET, mínimo 32 bytes aleatórios.
CREWCHECK_DATA_ENCRYPTION_KEY=

# Opcional. Quando vazio, o CrewLock usa o fallback cifrado no Aiven.
# Formato fornecido pelo Cloudinary, sem publicar o valor.
CLOUDINARY_URL=
